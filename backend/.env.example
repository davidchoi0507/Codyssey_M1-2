# ==========================================
# SoundPulse AI 환경 변수 설정 템플릿
# ==========================================

# 1. AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Firestore 설정
# (Render 배포 시에는 JSON 내용을 한 줄 문자열로 넣고, 로컬에서는 파일 경로 사용 가능)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# 3. CORS 허용 도메인 (Vercel 배포 도메인 포함)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8000,http://127.0.0.1:5500,http://127.0.0.1:8000,https://*.vercel.app

